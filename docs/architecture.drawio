<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="twinsmith-architecture" name="twinsmith architecture">
    <mxGraphModel dx="1560" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1070" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="client" value="&lt;b&gt;MCP client&lt;/b&gt;&lt;br&gt;Claude Code, Codex, OpenCode, Claude Desktop, any MCP client" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="440" height="70" as="geometry"/></mxCell>
        <mxCell id="config" value="&lt;b&gt;Configuration&lt;/b&gt;&lt;br&gt;MCP client entry, environment variables (docs/ENVIRONMENT.md),&lt;br&gt;project file, asset approval config" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="20" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="host" value="&lt;b&gt;twinsmith host server  (mcp/twinsmith; one process per client; needs no simulator).  A client is shown the enabled toolsets' tools, grouped with an action&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1480" height="300" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;help&lt;br&gt;refresh_tools&lt;br&gt;use_bridge&lt;br&gt;&lt;br&gt;finds bridges by port&lt;br&gt;or runtime portfile" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="230" as="geometry"/></mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Simulator tools (from a catalog)&lt;/b&gt;&lt;br&gt;sim__*  scene, physics, sensors,&lt;br&gt;  controller runs, replay&lt;br&gt;assets__*  import, packs&lt;br&gt;workcell__*  the lab work cell&lt;br&gt;built-ins: status, run_python,&lt;br&gt;  job_status, job_cancel, files" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="broker" value="&lt;b&gt;Asset broker&lt;/b&gt;&lt;br&gt;approved roots and packs&lt;br&gt;snapshot into staging&lt;br&gt;URDF, xacro, SDF, MJCF,&lt;br&gt;mesh and map conversion&lt;br&gt;(no code from a file is run)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="220" height="230" as="geometry"/></mxCell>
        <mxCell id="labtools" value="&lt;b&gt;Isaac Lab and script jobs&lt;/b&gt;&lt;br&gt;isaaclab__*  (toolset: sim)&lt;br&gt;run_script&lt;br&gt;&lt;br&gt;install choice per call,&lt;br&gt;GPU guards, job folder,&lt;br&gt;health and progress" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="200" width="220" height="230" as="geometry"/></mxCell>
        <mxCell id="screen" value="&lt;b&gt;Desktop and recording&lt;/b&gt;&lt;br&gt;screenshot&lt;br&gt;screen_recording&lt;br&gt;join_videos (clips, sheet,&lt;br&gt;  frames to MP4)&lt;br&gt;window tools;&lt;br&gt;computer (toolset: computer)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="200" height="230" as="geometry"/></mxCell>
        <mxCell id="sessions" value="&lt;b&gt;Simulator sessions&lt;/b&gt;&lt;br&gt;simulators: launch,&lt;br&gt;list, status, stop&lt;br&gt;&lt;br&gt;toolset computer: never in a&lt;br&gt;profile; name it with +computer&lt;br&gt;(it starts GPU processes)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="200" width="180" height="230" as="geometry"/></mxCell>
        <mxCell id="kit" value="&lt;b&gt;Isaac Sim  (one Kit process per simulator; ./run.sh or simulators)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="700" height="370" as="geometry"/></mxCell>
        <mxCell id="bridge" value="&lt;b&gt;twinsmith.bridge&lt;/b&gt;&lt;br&gt;TCP server, default :8766&lt;br&gt;JSON lines with request ids&lt;br&gt;token; read-only mode&lt;br&gt;inline, exclusive, in order&lt;br&gt;jobs, run_python, file tools" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="simtools" value="&lt;b&gt;sim-tools&lt;/b&gt;&lt;br&gt;sim.* and assets.* tools&lt;br&gt;session-layer edits only&lt;br&gt;exact stepping,&lt;br&gt;controller runs, replay,&lt;br&gt;camera and LiDAR capture" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="650" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="twin" value="&lt;b&gt;workcell&lt;/b&gt;&lt;br&gt;UR5e work cell tools&lt;br&gt;(toolset: sim)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;USD stage  ·  Newton (target) or PhysX  ·  RTX renderer  ·  bundled ROS 2 bridge" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="660" height="90" as="geometry"/></mxCell>
        <mxCell id="lab" value="&lt;b&gt;Isaac Lab job processes&lt;/b&gt;&lt;br&gt;train, eval, play, record,&lt;br&gt;env_check, your own script&lt;br&gt;each its own process group&lt;br&gt;(and its own Kit)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="600" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="x11" value="&lt;b&gt;Desktop (X11)&lt;/b&gt;&lt;br&gt;application windows,&lt;br&gt;read by window id:&lt;br&gt;works covered or locked" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="600" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="ros" value="&lt;b&gt;ROS 2 clients (optional)&lt;/b&gt;&lt;br&gt;RViz 2, Nav2, your ROS nodes&lt;br&gt;/clock, /tf, /joint_states&lt;br&gt;Cyclone DDS on loopback&lt;br&gt;(config/ros_dds.env)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="files" value="&lt;b&gt;Files on this machine&lt;/b&gt;&lt;br&gt;asset root and packs  (TWINSMITH_ASSET_ROOT)&lt;br&gt;staging  (~/.cache/twinsmith/staging)&lt;br&gt;scene output: captures, frames, CSV logs&lt;br&gt;  (TWINSMITH_SCENE_OUTPUT)&lt;br&gt;jobs folder: one record per job, Lab or simulator&lt;br&gt;  (TWINSMITH_JOBS_DIR)&lt;br&gt;~/Pictures/twinsmith, ~/Videos/twinsmith&lt;br&gt;session records, server log, help-gaps.jsonl" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="800" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;A tool call takes one of three routes: answered by the host itself, forwarded to the selected bridge, or run as a job process.&lt;/b&gt;&lt;br&gt;Grouped tools run single-purpose tools behind them; each still answers to its own name." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="982" width="1040" height="62" as="geometry"/></mxCell>
        <mxCell id="e0" value="MCP over stdio (JSON-RPC): tools/list, tools/call" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="host"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="status, discovery" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.2727;exitY=1;exitDx=0;exitDy=0;entryX=0.2857;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="bridge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="JSON lines over TCP, loopback, token" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.762;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="bridge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="500"/><mxPoint x="220" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="starts run.sh, checks readiness" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.943;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sessions" target="kit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="475"/><mxPoint x="700" y="475"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="reads approved files, writes snapshots" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="broker" target="files"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="545"/><mxPoint x="1420" y="545"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="starts, watches, cancels" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6333;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="labtools" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="pixels, placement" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4444;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="screen" target="x11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="logs, checkpoints, videos" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.8667;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="files"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="775"/><mxPoint x="1160" y="775"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="reads staging; writes output and job records" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=1;exitY=0.946;exitDx=0;exitDy=0;entryX=0;entryY=0.625;entryDx=0;entryDy=0;" edge="1" parent="1" source="kit" target="files"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="DDS" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#444444;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="runtime" target="ros"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
